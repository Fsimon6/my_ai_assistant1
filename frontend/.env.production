# 前端生产环境配置
VITE_APP_NAME=我的AI知识库助手
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# API配置
# 生产使用相对路径（由 nginx 反向代理 /api 到 backend），不硬编码域名/IP；
# 开发环境见 .env.development（VITE_API_BASE_URL=http://localhost:8000）。
VITE_API_BASE_URL=
VITE_API_TIMEOUT=60000

# WebSocket配置
VITE_WS_URL=wss://${VITE_APP_DOMAIN}/ws

# 功能开关
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DEBUG=false
VITE_ENABLE_MOCK_API=false

# 第三方服务
VITE_SENTRY_DSN=
VITE_GOOGLE_ANALYTICS_ID=
VITE_UMAMI_WEBSITE_ID=

# 页面配置
VITE_PAGE_SIZE=50
VITE_MAX_UPLOAD_SIZE=100

# 性能优化
VITE_ENABLE_GZIP=true
VITE_ENABLE_BROTLI=true
VITE_ENABLE_CACHE=true