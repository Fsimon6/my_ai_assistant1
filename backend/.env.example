# ===== 应用配置示例（复制为 .env 并填入真实值，.env 不要提交 Git） =====

# JWT 签名密钥（必填，无默认值；缺失时应用启动必须失败）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-random-secret-string

# 通用大模型调用密钥（OpenAI / DashScope / 智谱 需要；Ollama / local 可留空）
API_KEY=sk-your-api-key-here

# 大模型供应商：openai | dashscope | zhipu | ollama | local
LLM_PROVIDER=openai

# OpenAI 兼容接口地址（可选）
# - openai: 留空即用默认 https://api.openai.com/v1
# - dashscope: https://dashscope.aliyuncs.com/compatible-mode/v1
# - zhipu: https://open.bigmodel.cn/api/paas/v4
# - ollama / local: http://localhost:11434/v1
LLM_BASE_URL=

# 模型名称（如 gpt-3.5-turbo / deepseek-chat / glm-4 / qwen-plus）
LLM_MODEL=gpt-3.5-turbo

# 跨域允许的来源（逗号分隔）
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 日志级别
LOG_LEVEL=INFO
